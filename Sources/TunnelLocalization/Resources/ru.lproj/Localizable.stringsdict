<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>routing.rule_count</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld правило</string>
			<key>few</key>
			<string>%lld правила</string>
			<key>many</key>
			<string>%lld правил</string>
			<key>other</key>
			<string>%lld правил</string>
		</dict>
	</dict>
	<key>awg.address_count</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld адрес</string>
			<key>few</key>
			<string>%lld адреса</string>
			<key>many</key>
			<string>%lld адресов</string>
			<key>other</key>
			<string>%lld адресов</string>
		</dict>
	</dict>
	<key>awg.server_count</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld сервер</string>
			<key>few</key>
			<string>%lld сервера</string>
			<key>many</key>
			<string>%lld серверов</string>
			<key>other</key>
			<string>%lld серверов</string>
		</dict>
	</dict>
</dict>
</plist>
