+package reality
+
+import utls "github.com/refraction-networking/utls"
+
+// shadowrocketSafari15Spec is an opt-in compatibility profile using only
+// public uTLS presets and observed configuration values. It does not reproduce
+// BoringSSL's exact extension serialization or native TCP behavior.
+func shadowrocketSafari15Spec() (*utls.ClientHelloSpec, error) {
+	spec, err := utls.UTLSIdToSpec(utls.HelloSafari_16_0)
+	if err != nil {
+		return nil, err
+	}
+	extensions := make([]utls.TLSExtension, 0, len(spec.Extensions))
+	for _, extension := range spec.Extensions {
+		if _, ok := extension.(*utls.ALPNExtension); ok {
+			continue
+		}
+		if signatures, ok := extension.(*utls.SignatureAlgorithmsExtension); ok {
+			seenPSS384 := false
+			algorithms := make([]utls.SignatureScheme, 0, len(signatures.SupportedSignatureAlgorithms))
+			for _, algorithm := range signatures.SupportedSignatureAlgorithms {
+				if algorithm == utls.PSSWithSHA384 {
+					if seenPSS384 {
+						continue
+					}
+					seenPSS384 = true
+				}
+				algorithms = append(algorithms, algorithm)
+			}
+			signatures.SupportedSignatureAlgorithms = algorithms
+		}
+		extensions = append(extensions, extension)
+	}
+	spec.Extensions = extensions
+	return &spec, nil
+}
