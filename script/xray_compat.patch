@@ -0,0 +1,75 @@
+package reality
+
+import (
+	"encoding/binary"
+	"testing"
+
+	utls "github.com/refraction-networking/utls"
+	"github.com/xtls/xray-core/transport/internet/tls"
+)
+
+func TestTunnelDeckSafari15ClientHello(t *testing.T) {
+	if tls.GetFingerprint("tunneldeck_safari15_5") == nil {
+		t.Fatal("experimental profile must pass Xray fingerprint validation")
+	}
+	spec, err := tunnelDeckSafari15Spec()
+	if err != nil {
+		t.Fatal(err)
+	}
+	connection := utls.UClient(nil, &utls.Config{ServerName: "example.invalid", SessionTicketsDisabled: true}, utls.HelloCustom)
+	if err := connection.ApplyPreset(spec); err != nil {
+		t.Fatal(err)
+	}
+	if err := connection.BuildHandshakeState(); err != nil {
+		t.Fatal(err)
+	}
+	if connection.HandshakeState.State13.KeyShareKeys.Ecdhe == nil {
+		t.Fatal("REALITY needs an ordinary X25519 key share")
+	}
+	hello := connection.HandshakeState.Hello.Raw
+	// Inspect the serialized ClientHello, without opening any network connection.
+	if len(hello) < 39 || hello[0] != 1 {
+		t.Fatal("missing marshalled ClientHello")
+	}
+	position := 39 + int(hello[38])
+	position += 2 + int(binary.BigEndian.Uint16(hello[position:]))
+	position += 1 + int(hello[position])
+	end := position + 2 + int(binary.BigEndian.Uint16(hello[position:]))
+	position += 2
+	pss384Count := 0
+	for position < end {
+		kind := binary.BigEndian.Uint16(hello[position:])
+		length := int(binary.BigEndian.Uint16(hello[position+2:]))
+		payload := hello[position+4 : position+4+length]
+		if kind == 16 {
+			t.Fatal("raw native profile must not emit an ALPN extension")
+		}
+		if kind == 13 {
+			for index := 2; index < len(payload); index += 2 {
+				if binary.BigEndian.Uint16(payload[index:]) == uint16(utls.PSSWithSHA384) {
+					pss384Count++
+				}
+			}
+		}
+		position += 4 + length
+	}
+	if pss384Count != 1 {
+		t.Fatalf("native signature list has one RSA-PSS-SHA384 entry, got %d", pss384Count)
+	}
+}
+
+func TestTunnelDeckSafari15DoesNotMutateStockSafari(t *testing.T) {
+	if _, err := tunnelDeckSafari15Spec(); err != nil {
+		t.Fatal(err)
+	}
+	spec, err := utls.UTLSIdToSpec(utls.HelloSafari_16_0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, extension := range spec.Extensions {
+		if _, ok := extension.(*utls.ALPNExtension); ok {
+			return
+		}
+	}
+	t.Fatal("building the experimental profile must not remove stock Safari ALPN")
+}

